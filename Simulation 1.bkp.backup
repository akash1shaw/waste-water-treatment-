False" SelectedWatchItem="Overall Max-Error/Tol" Messages="&amp;lt;&amp;lt; Loading Simulation Engine 17:12:58 Wed Oct 7, 2026&amp;gt;&amp;gt;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;&amp;lt; Run Saved &amp;gt;&amp;gt;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;&amp;lt; Run Saved &amp;gt;&amp;gt;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;-&amp;gt;Processing input specifications ...&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      INFORMATION&amp;#xD;&amp;#xA;      THERE ARE HENRY COMPONENTS DEFINED IN THIS CASE, THE BINARY DATABANK&amp;#xD;&amp;#xA;      WILL BE SEARCHED AUTOMATICALLY FOR ANY AVAILABLE HENRY CONSTANTS.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      THE PAIR PARAMETERS FOR ELECNRTL OPTION SET HAS BEEN RETRIEVED FROM&amp;#xD;&amp;#xA;      DATABANK ENRTL-RK.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      INFORMATION&amp;#xD;&amp;#xA;      PURE COMPONENT PARAMETERS FOR SOME COMPONENTS ARE RETRIEVED FROM&amp;#xD;&amp;#xA;      DATABANK ELECPURE. THESE PARAMETERS ARE USED WITH ELECNRTL METHOD.&amp;#xD;&amp;#xA;      UNLESS YOU ENTER YOUR OWN PARAMETERS IN PROP-DATA PARAGRAPHS.&amp;#xD;&amp;#xA;      PARAMETER PLXANT RETRIEVED FOR COMPONENT HCL&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER PLXANT RETRIEVED FOR COMPONENT WATER&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER CPDIEC RETRIEVED FOR COMPONENT HCL&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER THRSWT(ELEMENT/3) RETRIEVED FOR COMPONENT HCL&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER THRSWT(ELEMENT/3) RETRIEVED FOR COMPONENT WATER&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER VLBROC RETRIEVED FOR COMPONENT CO2&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;-&amp;gt;Table Generation begins ...&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;-&amp;gt;Table generation completed&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;&amp;lt; Run Saved &amp;gt;&amp;gt;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;&amp;lt; Run Saved &amp;gt;&amp;gt;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;&amp;lt; Run Saved &amp;gt;&amp;gt;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;-&amp;gt;Processing input specifications ...&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      INFORMATION&amp;#xD;&amp;#xA;      THERE ARE HENRY COMPONENTS DEFINED IN THIS CASE, THE BINARY DATABANK&amp;#xD;&amp;#xA;      WILL BE SEARCHED AUTOMATICALLY FOR ANY AVAILABLE HENRY CONSTANTS.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      THE PAIR PARAMETERS FOR ELECNRTL OPTION SET HAS BEEN RETRIEVED FROM&amp;#xD;&amp;#xA;      DATABANK ENRTL-RK.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      INFORMATION&amp;#xD;&amp;#xA;      PURE COMPONENT PARAMETERS FOR SOME COMPONENTS ARE RETRIEVED FROM&amp;#xD;&amp;#xA;      DATABANK ELECPURE. THESE PARAMETERS ARE USED WITH ELECNRTL METHOD.&amp;#xD;&amp;#xA;      UNLESS YOU ENTER YOUR OWN PARAMETERS IN PROP-DATA PARAGRAPHS.&amp;#xD;&amp;#xA;      PARAMETER PLXANT RETRIEVED FOR COMPONENT HCL&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER PLXANT RETRIEVED FOR COMPONENT WATER&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER CPDIEC RETRIEVED FOR COMPONENT HCL&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER THRSWT(ELEMENT/3) RETRIEVED FOR COMPONENT HCL&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER THRSWT(ELEMENT/3) RETRIEVED FOR COMPONENT WATER&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      PARAMETER VLBROC RETRIEVED FOR COMPONENT CO2&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;  *   WARNING IN PHYSICAL PROPERTY SYSTEM&amp;#xD;&amp;#xA;      THE FOLLOWING CONVENTIONAL COMPONENTS WERE NOT IN A DATA BANK.&amp;#xD;&amp;#xA;      CHECK DATA BANK NAMES FOR SPELLING.&amp;#xD;&amp;#xA;      CID       DATA BANK NAME&amp;#xD;&amp;#xA;        WATER     H2O&amp;#xD;&amp;#xA;        NACL      NACL&amp;#xD;&amp;#xA;        MGCL2     MGCL2&amp;#xD;&amp;#xA;        CACL2     CACL2&amp;#xD;&amp;#xA;        NAHCO3    NAHCO3&amp;#xD;&amp;#xA;        CA++      CA+2&amp;#xD;&amp;#xA;        MG++      MG+2&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;  Flowsheet Analysis :&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA; COMPUTATION ORDER FOR THE FLOWSHEET:&amp;#xD;&amp;#xA; ADSORBER&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;-&amp;gt;Calculations begin ...&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;  *   WARNING IN PHYSICAL PROPERTY SYSTEM WHILE PERFORMING INITIAL ENTHALPY&amp;#xD;&amp;#xA;      CALCULATIONS FOR STREAM: &amp;quot;CBM-FEED&amp;quot;&amp;#xD;&amp;#xA;      ONE OF DHAQFM AND DGAQFM FOR MGOH+ IS MISSING, PROVIDE THE VALUE,&amp;#xD;&amp;#xA;      OR USE PCES TO ESTIMATE IT.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;      HENRY CONSTANT MODEL HENRY1 HAS MISSING PARAMETERS. PLEASE&amp;#xD;&amp;#xA;      PROVIDE THE MISSING PARAMETERS FOR MAJOR SOLVENTS. THIS ERROR MAY OCCUR&amp;#xD;&amp;#xA;      BECAUSE THE STREAM IS ALL VAPOR, BUT VLE CALCULATION IS REQUESTED.&amp;#xD;&amp;#xA;      TRY SPECIFY VALID-PHASES=VAPOR-ONLY&amp;#xD;&amp;#xA;      HENRY/1ST ELEMENT (DATA SET 1) MISSING FOR SUPERCRITICAL COMPONENT&amp;#xD;&amp;#xA;      HCL WITH ALL SOLVENTS:&amp;#xD;&amp;#xA;        *&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;  *   WARNING IN PHYSICAL PROPERTY SYSTEM WHILE PERFORMING INITIAL ENTHALPY&amp;#xD;&amp;#xA;      CALCULATIONS FOR STREAM: &amp;quot;CBM-FEED&amp;quot;&amp;#xD;&amp;#xA;      ONE OF DHAQFM AND DGAQFM FOR MGOH+ IS MISSING, PROVIDE THE VALUE,&amp;#xD;&amp;#xA;      OR USE PCES TO ESTIMATE IT.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;  ****PROPERTY PARAMETER ERROR&amp;#xD;&amp;#xA;      ERRORS ENCOUNTERED IN CALCULATION OF IDEAL GAS PROPS FOR&amp;#xD;&amp;#xA;      GIG&amp;#xD;&amp;#xA;      PLEASE FIX THE ERRORS, RE-INITIALIZE, AND RUN AGAIN.&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;! Calculations stopped because of missing  property parameters&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;lt;&amp;lt; Run Saved &amp;gt;&amp;gt;&amp;#xD;&amp;#xA;" /&gt;&lt;/WorkspaceScreenData.ScreenState&gt;&lt;/WorkspaceScreenData&gt;&lt;WorkspaceScreenData PaneName="_AnonymousScreen2" ScreenFactoryKey="ApwnFormContentFa